# Modifier: Super / Windows key
set $mod Ctrl
set $mod2 Mod1
# Applications
bindsym $mod+Return exec kitty
bindsym $mod+$mod2+d exec dmenu_run


# French AZERTY keyboard layout
exec_always --no-startup-id ~/.config/i3/startup.sh
exec_always --no-startup-id feh --bg-fill /usr/share/backgrounds/ubuntu-wallpaper-d.png 
# Suspend after 10 minutes of inactivity
exec --no-startup-id xautolock -time 5 -locker "systemctl suspend"

# Reload and restart
bindsym $mod+$mod2+c reload
bindsym $mod+$mod2+r restart

# Fullscreen
bindsym $mod+$mod2+f fullscreen toggle

# Toggle horizontal / vertical split
bindsym $mod+$mod2+t layout toggle split


# Switch to stacking layout
bindsym $mod+$mod2+s layout stacking

# Switch to tabbed layout
bindsym $mod+$mod2+w layout tabbed

# Toggle between split layouts
bindsym $mod+$mod2+e layout toggle split

# Window focus with Alt + H/J/K/L
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows with Alt + Shift + H/J/K/L
bindsym $mod+$mod2+h move left
bindsym $mod+$mod2+j move down
bindsym $mod+$mod2+k move up
bindsym $mod+$mod2+l move right

# Drag windows with the Super/Windows key + mouse
floating_modifier Mod4

# Switch workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move window to workspace and switch to it
bindsym $mod2+1 move container to workspace number 1; workspace number 1
bindsym $mod2+2 move container to workspace number 2; workspace number 2
bindsym $mod2+3 move container to workspace number 3; workspace number 3
bindsym $mod2+4 move container to workspace number 4; workspace number 4
bindsym $mod2+5 move container to workspace number 5; workspace number 5
bindsym $mod2+6 move container to workspace number 6; workspace number 6
bindsym $mod2+7 move container to workspace number 7; workspace number 7
bindsym $mod2+8 move container to workspace number 8; workspace number 8
bindsym $mod2+9 move container to workspace number 9; workspace number 9
bindsym $mod2+0 move container to workspace number 10; workspace number 10


# Laptop screen: workspaces 6-10
workspace 5 output HDMI-1-0
workspace 6 output HDMI-1-0
workspace 7 output HDMI-1-0
workspace 8 output HDMI-1-0
workspace 9 output HDMI-1-0
workspace 10 output HDMI-1-0

# External screen: workspaces 1-5
workspace 1 output eDP
workspace 2 output eDP
workspace 3 output eDP
workspace 4 output eDP


# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Exit' 'i3-msg exit'"

# App launcher — Alt + Space (Spotlight-style)
bindsym $mod+space exec rofi -show drun
# Kill focused window
bindsym $mod+$mod2+q kill

# Assign apps to workspaces => xprop WM_CLASS
assign [class="Brave"] 1
assign [class="kitty"] 2
assign [class="Postman"] 3
assign [class="org.gnome.Nautilus"] 4


assign [class="Trello Desktop"] 6
assign [class="code_code"] 5

# Launch apps at login
exec --no-startup-id brave
exec --no-startup-id code
