# Modifier: Super / Windows key
set $mod Mod1

# Applications
bindsym $mod+Return exec kitty
bindsym $mod+d exec dmenu_run


# French AZERTY keyboard layout
exec_always --no-startup-id ~/.config/i3/startup.sh
exec_always --no-startup-id feh --bg-fill /usr/share/backgrounds/ubuntu-wallpaper-d.png 
# Reload and restart
bindsym $mod+Ctrl+c reload
bindsym $mod+Ctrl+r restart

# Fullscreen
bindsym $mod+Ctrl+f fullscreen toggle

# Toggle horizontal / vertical split
bindsym $mod+Ctrl+t layout toggle split


# Switch to stacking layout
bindsym $mod+Ctrl+s layout stacking

# Switch to tabbed layout
bindsym $mod+Ctrl+w layout tabbed

# Toggle between split layouts
bindsym $mod+Ctrl+e layout toggle split

# Window focus with Alt + H/J/K/L
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows with Alt + Shift + H/J/K/L
bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+j move down
bindsym $mod+Ctrl+k move up
bindsym $mod+Ctrl+l move right

# Drag windows with the Super/Windows key + mouse
floating_modifier Mod4

# Switch workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move window to workspace and switch to it
bindsym Ctrl+1 move container to workspace number 1; workspace number 1
bindsym Ctrl+2 move container to workspace number 2; workspace number 2
bindsym Ctrl+3 move container to workspace number 3; workspace number 3
bindsym Ctrl+4 move container to workspace number 4; workspace number 4
bindsym Ctrl+5 move container to workspace number 5; workspace number 5
bindsym Ctrl+6 move container to workspace number 6; workspace number 6
bindsym Ctrl+7 move container to workspace number 7; workspace number 7
bindsym Ctrl+8 move container to workspace number 8; workspace number 8
bindsym Ctrl+9 move container to workspace number 9; workspace number 9
bindsym Ctrl+0 move container to workspace number 10; workspace number 10


# Laptop screen: workspaces 6-10
workspace 5 output HDMI-1-0
workspace 6 output HDMI-1-0
workspace 7 output HDMI-1-0
workspace 8 output HDMI-1-0
workspace 9 output HDMI-1-0
workspace 10 output HDMI-1-0

# External screen: workspaces 1-5
workspace 1 output eDP
workspace 2 output eDP
workspace 3 output eDP
workspace 4 output eDP


# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Exit' 'i3-msg exit'"

# App launcher — Alt + Space (Spotlight-style)
bindsym $mod+space exec rofi -show drun
# Kill focused window
bindsym $mod+Ctrl+q kill

# Assign apps to workspaces
assign [class="Brave"] 1
assign [class="code_code"] 5

# Launch apps at login
exec --no-startup-id brave
exec --no-startup-id code
